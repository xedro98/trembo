# Trumbo Code desktop app public build configuration.
# Leave these unset to fall back to the built-in Trumbo platform defaults.
# Release builds inject their public values at build time. Do not add
# server-side secrets to this file.

# Trumbo platform base URL. The desktop app runs the RFC 8626 device-code
# flow against ${TRUMBO_CODE_PLATFORM_URL}/oauth/device and reads the signed-in
# user's subscription from ${TRUMBO_CODE_PLATFORM_URL}/api/billing/subscription.
# Defaults to https://platform.trumbo.dev.
# TRUMBO_CODE_PLATFORM_URL=https://platform.trumbo.dev

# Public OAuth client id registered on the Trumbo platform for the desktop app.
# Defaults to trumbo-code-desktop.
# TRUMBO_CODE_OAUTH_CLIENT_ID=trumbo-code-desktop

# Optional: relay (Trumbo Connect) source builds. The relay infra and mobile
# apps still consume Clerk JWTs during the migration off Clerk; these are only
# needed when running the relay locally or building signed mobile passkey bits.
# Get these from the Clerk Dashboard under API keys, JWT templates, and OAuth applications.
# TRUMBO_CODE_CLERK_PUBLISHABLE_KEY=pk_test_...
# TRUMBO_CODE_CLERK_JWT_TEMPLATE=trumbo-relay
# TRUMBO_CODE_CLERK_CLI_OAUTH_CLIENT_ID=oauthapp_...

# Optional: signed macOS builds. Code signing uses the standard CSC_* / Apple
# API key env vars. Passkey entitlements are only added when an explicit RP
# domain + Apple team id + provisioning profile are provided.
# TRUMBO_CODE_APPLE_TEAM_ID=ABC1234567
# TRUMBO_CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/trumbo-code.provisionprofile
# TRUMBO_CODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Defaults to https://relay.trumbo.dev when unset.
# TRUMBO_CODE_RELAY_URL=https://relay.trumbo.dev

# Public, ingest-only mobile OpenTelemetry configuration.
# TRUMBO_CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# TRUMBO_CODE_MOBILE_OTLP_TRACES_DATASET=trumbo-code-mobile-traces-dev
# TRUMBO_CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
